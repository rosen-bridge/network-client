{
  "name": "@rosen-clients/ergo-node",
  "version": "2.0.0",
  "description": "A client library for Ergo Node",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "scripts": {
    "codemod": "jscodeshift --parser=ts -t ../../codemod/big-int-fields-support.ts ./src/**/*.ts",
    "generate-client": "orval && rimraf ./src/api/index.ts && npm run codemod",
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "rimraf ./dist && tsc --build",
    "type-check": "tsc --noEmit",
    "release": "npm run build && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/network-client"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jscodeshift": "^0.11.6",
    "@types/node": "^22.18.0",
    "eslint": "^8.16.0",
    "jscodeshift": "^0.14.0",
    "orval": "^6.15.0",
    "rimraf": "^4.4.1",
    "typescript": "^5.0.3"
  },
  "keywords": [
    "rosen",
    "ergo"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-clients/axios": "^0.1.5"
  }
}
