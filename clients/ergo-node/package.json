{
  "name": "@rosen-clients/ergo-node",
  "version": "3.1.1",
  "description": "A client library for Ergo Node",
  "keywords": [
    "rosen",
    "ergo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/network-client"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "codemod": "jscodeshift --parser=ts -t ../../codemod/big-int-fields-support.ts ./src/**/*.ts",
    "generate-client": "orval && rimraf ./src/api/index.ts && npm run codemod",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run clean && npm run build && npm publish --access public",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-clients/axios": "^1.1.1"
  },
  "devDependencies": {
    "@types/jscodeshift": "^0.11.6",
    "jscodeshift": "^0.14.0",
    "orval": "^7.13.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
