{
  "name": "@rosen-clients/ergo-explorer",
  "version": "2.0.0",
  "description": "A client library for Ergo Explorer",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "scripts": {
    "codemod": "jscodeshift --parser=ts -t ../../codemod/big-int-fields-support.ts ./src/**/**/*.ts",
    "generate-v0-client": "cross-env VERSION=0 orval && rimraf ./src/v0/api/index.ts ",
    "generate-v1-client": "cross-env VERSION=1 orval && rimraf ./src/v1/api/index.ts",
    "generate-client": "npm run generate-v0-client && npm run generate-v1-client && npm run codemod",
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint . && npm run prettify",
    "build": "rimraf ./dist && tsc --build",
    "type-check": "tsc --noEmit",
    "release": "npm run build && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/network-client"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jscodeshift": "^0.11.6",
    "cross-env": "^7.0.3",
    "jscodeshift": "^0.14.0",
    "orval": "6.15.0",
    "rimraf": "^4.4.1"
  },
  "keywords": [
    "rosen",
    "ergo"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-clients/axios": "^1.0.0"
  }
}
