{
  "name": "@rosen-clients/rate-limited-axios",
  "version": "2.0.0",
  "description": "A lightweight rate-limiting wrapped Axios that helps control the number of HTTP requests and prevent API throttling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/network-client"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run clean && npm run build && npm publish --access public",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/semaphore": "^0.1.0",
    "axios": "^1.13.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
