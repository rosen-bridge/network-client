{
  "name": "@rosen-clients/axios",
  "version": "1.0.0",
  "description": "create axios client for swagger clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/network-client"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
